@host = http://localhost:8080

### 1. Listar todos
GET {{host}}/violas

### 2. Buscar por id
GET {{host}}/violas/1

### 3. Filtro por modelo
GET {{host}}/violas/modelo/ponteio

### 4. Filtro por marca
GET {{host}}/violas/marca/rozini

### 5. Filtro por afinacao
GET {{host}}/violas/afinacao/CEBOLAO_RE

### 6. Filtro por faixa de preco
GET {{host}}/violas/preco?min=800&max=2500

### 7. Filtro por faixa de cordas
GET {{host}}/violas/cordas?min=10&max=12

### 8. Filtro por faixa de fabricacao
GET {{host}}/violas/fabricacao?inicio=2019-01-01&fim=2023-12-31

### 9. Filtro combinado
GET {{host}}/violas/filtros?marca=rozini&afinacao=CEBOLAO_MI&precoMax=3000

### 10. Inserir
POST {{host}}/violas
Content-Type: application/json

{
  "modelo": "Cabocla de Luxo",
  "marca": "Rozini",
  "afinacao": "CEBOLAO_RE",
  "fabricacao": "2023-08-10",
  "preco": 2890.00,
  "cordas": 10
}

### 11. Atualizar
PUT {{host}}/violas/1
Content-Type: application/json

{
  "modelo": "RV-01 Special",
  "marca": "Rozini",
  "afinacao": "CEBOLAO_RE",
  "fabricacao": "2019-03-12",
  "preco": 1490.00,
  "cordas": 10
}

### 12. Excluir
DELETE {{host}}/violas/6
